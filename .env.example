# Kredensial Login Kemnaker (SIAP / MagangHub)
KEMNAKER_EMAIL=email_anda@example.com
KEMNAKER_PASSWORD=password_anda

# Target URL & Data
BASE_URL=https://monev.maganghub.kemnaker.go.id/dashboard/riwayat
DATA_FILE=data_presensi_maganghub.json
CHROME_PROFILE_DIR=./chrome_profile

# Browser & Eksekusi
# Set HEADLESS=false saat development agar jendela Chrome terlihat di layar
# Set HEADLESS=true saat deploy di server tanpa GUI
HEADLESS=false
DRY_RUN=true
STEP_DELAY_SEC=3

# Jadwal (Senin - Jumat pukul 15:00 WIB)
TIMEZONE=Asia/Jakarta
SCHEDULE_HOUR=15
SCHEDULE_MINUTE=0

# Retensi log & screenshot (hari)
LOG_RETENTION_DAYS=5
